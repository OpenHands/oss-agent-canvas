{
  "name": "fix-failing-version-bump",
  "version": "0.1.0",
  "description": "Executable automation plugin for Fix Failing Version Bump (dependabot): extensions, OpenHands, software-agent-sdk, automation, enterprise.",
  "author": {
    "name": "OpenHands",
    "email": "contact@all-hands.dev"
  },
  "homepage": "https://github.com/OpenHands/oss-agent-canvas",
  "repository": "https://github.com/OpenHands/oss-agent-canvas",
  "license": "MIT",
  "keywords": [
    "automation",
    "fix-failing-version-bump"
  ],
  "automation": {
    "schema_version": "openhands.automation.plugin.v1",
    "entrypoint": {
      "runner": "script",
      "working_dir": "scripts",
      "command": "python3 main.py"
    },
    "runtime": {
      "plugins": []
    },
    "config_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "suggested_trigger": {
      "type": "cron",
      "schedule": "0 0,12 * * *",
      "timezone": "UTC"
    }
  }
}
