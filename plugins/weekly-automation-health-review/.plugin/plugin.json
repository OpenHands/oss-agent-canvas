{
  "name": "weekly-automation-health-review",
  "version": "0.1.0",
  "description": "Executable automation plugin for Weekly Automation & Conversation Health Review.",
  "author": {
    "name": "OpenHands",
    "email": "contact@all-hands.dev"
  },
  "homepage": "https://github.com/OpenHands/oss-agent-canvas",
  "repository": "https://github.com/OpenHands/oss-agent-canvas",
  "license": "MIT",
  "keywords": [
    "automation",
    "weekly-automation-health-review"
  ],
  "automation": {
    "schema_version": "openhands.automation.plugin.v1",
    "entrypoint": {
      "runner": "script",
      "working_dir": "scripts",
      "command": "env .venv/bin/python main.py",
      "setup_script": "scripts/setup.sh"
    },
    "runtime": {
      "plugins": []
    },
    "config_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "suggested_trigger": {
      "type": "cron",
      "schedule": "0 0 * * 5",
      "timezone": "UTC"
    }
  }
}
