{
  "repos": [
    "OpenHands/automation",
    "OpenHands/OpenHands"
  ],
  "handle_dependabot": false,
  "pin_bump_branch": "bump-pins",
  "pin_bump_author": "openhands-release-bot[bot]",
  "pin_bump_dry_run": true,
  "pin_bump_files": {
    "OpenHands/automation": [
      "pyproject.toml",
      "uv.lock"
    ],
    "OpenHands/OpenHands": [
      "config/defaults.json",
      "package.json",
      "package-lock.json",
      ".agents/skills/local-stack-runtime/references/guide.md",
      "scripts/dev-safe.mjs",
      "scripts/check-sdk-version-sync.mjs",
      "__tests__/scripts/dev-safe.test.ts"
    ]
  },
  "pin_bump_checks": {
    "OpenHands/OpenHands": [
      "Check SDK version consistency"
    ]
  },
  "hold_label": "release: hold",
  "release_branches": {
    "OpenHands/automation": "release-please--branches--main",
    "OpenHands/OpenHands": "release-please--branches--main--components--agent-canvas"
  },
  "release_files": {
    "OpenHands/automation": [
      ".release-please-manifest.json",
      "openhands/automation/__init__.py",
      "openhands/automation/app.py",
      "pyproject.toml",
      "uv.lock"
    ],
    "OpenHands/OpenHands": [
      ".release-please-manifest.json",
      "README.md",
      "README.windows.md",
      "config/defaults.json",
      "helm/agent-canvas/Chart.yaml",
      "package.json",
      "package-lock.json"
    ]
  },
  "release_checks": {
    "OpenHands/OpenHands": [
      "Check SDK version consistency",
      "mock-llm-e2e",
      "windows-install-e2e"
    ]
  },
  "release_dry_run": true,
  "maintainers": [
    "neubig",
    "VascoSch92",
    "simonrosenberg",
    "juanmichelini",
    "malhotra5",
    "enyst"
  ],
  "minimal_fix_max_files": 10,
  "minimal_fix_max_changed_lines": 100
}
